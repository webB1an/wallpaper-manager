{
  "name": "wallpaper-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Wallpaper content operations system for WeChat Mini Program, admin console, cloud drive sync and Tencent Channel publishing.",
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:validate": "npm run prisma:validate -w apps/api",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:deploy": "npm run prisma:deploy -w apps/api",
    "package:release": "powershell -ExecutionPolicy Bypass -File deploy/package-release.ps1",
    "smoke:json": "npm run smoke:json -w apps/api"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
