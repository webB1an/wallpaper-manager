{
  "name": "wallpaper-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Wallpaper content operations system for WeChat Mini Program, admin console, cloud drive sync and Tencent Channel publishing.",
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:validate": "npm run prisma:validate -w apps/api",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:deploy": "npm run prisma:deploy -w apps/api",
    "package:release": "powershell -ExecutionPolicy Bypass -File deploy/package-release.ps1",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:json": "npm run smoke:json -w apps/api",
    "smoke:production": "npm run smoke:public && npm run smoke:admin",
    "smoke:production:strict": "node scripts/smoke-public.mjs && node scripts/smoke-admin.mjs --strict",
    "smoke:public": "node scripts/smoke-public.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/miniprogram",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript-eslint": "8.67.0"
  }
}
