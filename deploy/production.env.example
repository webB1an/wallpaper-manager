NODE_ENV=production
PORT=4000
PUBLIC_API_ORIGIN=https://wall-api.wdbzk.com
ADMIN_ORIGIN=https://wall-admin.wdbzk.com
SHORT_LINK_ORIGIN=https://r.wdbzk.com
MINIPROGRAM_APPID=
WECHAT_APP_SECRET=
WECHAT_MESSAGE_TOKEN=

# 个人主体小程序虚拟支付：在 MP 后台「虚拟支付 → 基本配置」获取。
VIRTUAL_PAY_OFFER_ID=CHANGE_ME
VIRTUAL_PAY_APP_KEY=CHANGE_ME
VIRTUAL_PAY_LIFETIME_PRODUCT_ID=download_lifetime
VIRTUAL_PAY_LIFETIME_PRICE=100

# Baota MySQL production database. Replace BAOTA_DB_HOST with the database host shown in the panel.
DATABASE_URL=mysql://wallpaper_manager_user:CHANGE_ME@BAOTA_DB_HOST:3306/wallpaper_manager
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARS

DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

PANAPI_BASE_URL=https://panapi.wdbzk.com
PANAPI_TOKEN=CHANGE_ME
PANAPI_CATEGORY_ID=61

OLD_WALLPAPER_ROOT=/www/wwwroot/wallpaper.wdbzk.com
OLD_COVER_SOURCE_DIR=
OLD_COVER_LIST_PATH=

QUARK_SKILL_DIR=/www/server/quarkclouddrive-1.0.14
QUARK_AUTH_START_TIMEOUT_MS=12000
QUARK_UPLOAD_PARENT_FID=

BDPAN_PATH=bdpan
BAIDU_REMOTE_BASE=/apps/bdpan/wallpapers
BAIDU_SHARE_PERIOD_DAYS=0
STORAGE_ACCOUNT_ROOT=/www/wwwroot/wallpaper-manager/storage/private/storage-accounts

# 小程序按需回源缓存：从网盘拉回服务器的源文件保留天数，过期自动清理
FETCHED_ASSET_TTL_DAYS=7
# 夸克回源时转存副本存放的网盘目录（CLI 无删除命令，便于定期手动清空）
QUARK_FETCH_SAVE_DIR=/wallpaper-fetch-tmp
# 百度回源时转存副本存放的网盘目录（相对 /apps/bdpan）
BAIDU_FETCH_TRANSFER_DIR=wallpaper-fetch-tmp

UPLOAD_MAX_FILE_MB=300
FFMPEG_PATH=ffmpeg
TENCENT_CHANNEL_CLI=
TENCENT_CHANNEL_RUN_ROOT=/www/wwwroot/wallpaper-manager/.runs/tencent-channel
