.panel {
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #ffffff;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #efe4d6;
  font-size: 28rpx;
}

.mine-meter {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  width: fit-content;
  margin-top: 26rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.mine-meter text:first-child {
  color: #e8b87b;
  font-size: 34rpx;
  font-weight: 820;
}

.mine-meter text:last-child {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.history-list {
  display: grid;
  gap: 16rpx;
}

.history-card {
  display: grid;
  grid-template-columns: 116rpx 1fr;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid #efe4d6;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 35, 28, 0.06);
}

.history-card image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 10rpx;
  background: #f0e4d6;
}

.history-main {
  min-width: 0;
}

.history-title,
.history-url,
.history-meta,
.history-passcode {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-title {
  color: #2b211b;
  font-size: 27rpx;
  font-weight: 760;
}

.history-url {
  margin-top: 8rpx;
  color: #8a7668;
  font-size: 22rpx;
}

.history-meta {
  margin-top: 8rpx;
  color: #c05621;
  font-size: 22rpx;
}

.history-passcode {
  width: fit-content;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 21rpx;
  font-weight: 760;
}

.history-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
}

.history-meta-row view {
  min-width: 0;
}

.history-meta-row .history-meta {
  margin-top: 0;
}

.history-time {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #a89484;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card button {
  flex-shrink: 0;
  width: 96rpx;
  max-width: 30vw;
  height: 64rpx;
  padding: 0;
  border-radius: 10rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 24rpx;
  line-height: 64rpx;
}

.history-card button::after {
  border: 0;
}

.empty-state {
  margin-top: 10rpx;
  padding: 64rpx 36rpx;
  border: 2rpx dashed #efe4d6;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.empty-state text:first-child {
  display: block;
  color: #2b211b;
  font-size: 30rpx;
  font-weight: 820;
}

.empty-state text:last-child {
  display: block;
  margin-top: 12rpx;
  color: #8a7668;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-state button {
  width: 210rpx;
  max-width: 100%;
  height: 68rpx;
  margin: 26rpx auto 0;
  padding: 0;
  border-radius: 12rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 68rpx;
}

.empty-state button::after {
  border: 0;
}
