<view class="page">
  <view class="hero">
    <text class="hero-title">服务中心</text>
    <text class="hero-subtitle">下载与收藏，随时找回</text>
    <view class="mine-meter">
      <text>{{favorites.length + downloads.length + records.length}}</text>
      <text>条记录</text>
    </view>
  </view>

  <view wx:if="{{quotaText}}" class="quota-card">{{quotaText}}</view>

  <view class="section-title">
    <text>收藏</text>
    <text wx:if="{{favorites.length}}" class="muted" bindtap="clearFavorites">清空</text>
  </view>
  <view wx:if="{{favorites.length}}" class="history-list">
    <block wx:for="{{favorites}}" wx:key="id">
      <view class="history-card" data-id="{{item.id}}" bindtap="openDetail">
        <image src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="history-main">
          <text class="history-title">{{item.title}}</text>
          <text class="history-time">{{item.atText}}</text>
        </view>
      </view>
    </block>
  </view>
  <view wx:else class="empty-state">
    <text>还没有收藏</text>
    <text>遇到喜欢的壁纸，点详情页的 ♡ 收藏起来。</text>
  </view>

  <view class="section-title">
    <text>下载记录</text>
    <text wx:if="{{downloads.length}}" class="muted" bindtap="clearDownloads">清空</text>
  </view>
  <view wx:if="{{downloads.length}}" class="history-list">
    <block wx:for="{{downloads}}" wx:key="id">
      <view class="history-card" data-id="{{item.id}}" bindtap="openDetail">
        <image src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="history-main">
          <text class="history-title">{{item.title}}</text>
          <text class="history-time">{{item.atText}}</text>
        </view>
      </view>
    </block>
  </view>
  <view wx:else class="empty-state">
    <text>还没有下载记录</text>
    <text>下载成功保存到相册的壁纸会出现在这里。</text>
  </view>

  <view class="section-title">
    <text>最近复制</text>
    <text wx:if="{{records.length}}" class="muted" bindtap="clearHistory">清空</text>
  </view>
  <view wx:if="{{records.length}}" class="history-list">
    <block wx:for="{{records}}" wx:key="url">
      <view class="history-card" data-id="{{item.id}}" bindtap="openDetail">
        <image src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="history-main">
          <text class="history-title">{{item.title}}</text>
          <text class="history-url">{{item.url}}</text>
          <text wx:if="{{item.passcode}}" class="history-passcode">提取码 {{item.passcode}}</text>
          <view class="history-meta-row">
            <view>
              <text class="history-meta">{{item.label}}</text>
              <text class="history-time">{{item.copiedAtText}}</text>
            </view>
            <button data-url="{{item.url}}" data-passcode="{{item.passcode}}" catchtap="copyLink">复制</button>
          </view>
        </view>
      </view>
    </block>
  </view>
  <view wx:else class="empty-state">
    <text>还没有复制记录</text>
    <text>复制壁纸链接后会自动保存在这里。</text>
  </view>

  <view class="panel">
    <view class="row">
      <text>关于</text>
      <text class="muted">Wallpaper 壁纸库</text>
    </view>
  </view>
</view>
