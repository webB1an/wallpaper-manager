.collection-page{padding:30rpx;background:#fbf7f0;min-height:100vh}.article-heading{padding:24rpx 6rpx 38rpx}.eyebrow{display:block;color:#ac947c;font-size:21rpx;letter-spacing:2rpx}.article-title{display:block;font-size:39rpx;line-height:1.6;font-weight:600;margin:22rpx 0;color:#47362b}.article-intro{display:block;font-size:27rpx;color:#8d7965;line-height:1.95;white-space:pre-wrap}.wallpaper-card{margin-bottom:30rpx;border-radius:18rpx;background:white;overflow:hidden;border:1rpx solid #eee4d7}.wallpaper-card>image{display:block;width:100%}.wallpaper-info{padding:24rpx}.wallpaper-info>view{display:flex;align-items:center;gap:16rpx}.number{color:#b76838;font-size:23rpx}.wallpaper-title{font-size:26rpx;color:#735d49}.wallpaper-info button{margin-top:22rpx;color:#b56738;background:#fbf4e9;font-size:25rpx;border:0}.wallpaper-info button::after{border:0}.state{text-align:center;padding:70rpx 20rpx;color:#a18b75;font-size:27rpx;line-height:1.8}.state text{display:block}.state button{margin-top:25rpx;font-size:26rpx;color:#b76a3b;width:180rpx}.state.small{font-size:22rpx;padding:25rpx}
