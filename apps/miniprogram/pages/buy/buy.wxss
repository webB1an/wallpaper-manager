.page {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  background: #fbf7f0;
}

.hero {
  margin: 34rpx -28rpx 0;
  padding: 48rpx 34rpx 42rpx;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(230, 181, 102, 0.2), transparent 46%),
    #2b211b;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 860;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 25rpx;
  line-height: 1.5;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  color: #e8b87b;
  background: rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
}

.purchase-card {
  margin-top: 28rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #efe4d6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(29, 37, 33, 0.08);
}

.purchase-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: baseline;
}

.purchase-title {
  color: #2b211b;
  font-size: 34rpx;
  font-weight: 820;
}

.purchase-price {
  color: #c05621;
  font-size: 40rpx;
  font-weight: 860;
}

.purchase-desc {
  display: block;
  margin-top: 16rpx;
  color: #8a7668;
  font-size: 25rpx;
  line-height: 1.55;
}

.feature-list {
  display: grid;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  color: #2b211b;
  background: #f7ead8;
  font-size: 24rpx;
}

.purchase-button {
  width: 100%;
  height: 82rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #e57355, #c05621);
  font-size: 28rpx;
  font-weight: 820;
  line-height: 82rpx;
}

.purchase-button::after {
  border: 0;
}

.purchase-note {
  display: block;
  margin-top: 18rpx;
  color: #a89484;
  font-size: 20rpx;
  line-height: 30rpx;
}

.state-card {
  display: grid;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 50rpx 30rpx;
  border: 2rpx dashed #efe4d6;
  border-radius: 18rpx;
  color: #8a7668;
  background: #ffffff;
  font-size: 25rpx;
  text-align: center;
}

.retry-button {
  width: 200rpx;
  height: 64rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 24rpx;
  line-height: 64rpx;
}

.retry-button::after {
  border: 0;
}
