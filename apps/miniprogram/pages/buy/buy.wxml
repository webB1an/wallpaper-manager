<view class="page">
  <view class="hero">
    <text class="hero-title">全部壁纸永久下载权益</text>
    <text class="hero-subtitle">{{purchased ? '权益已解锁，可随时查看全部壁纸资源' : '购买后获得全部壁纸资源，永久有效'}}</text>
    <view class="hero-badge">{{entitlementText}}</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text>正在加载商品信息…</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重试</button>
  </view>

  <view wx:if="{{!loading && !error && purchased}}" class="delivery-card">
    <view class="delivery-head">
      <text class="delivery-title">全部壁纸资源</text>
      <text class="delivery-tip">点击对应资源复制链接，请妥善保存</text>
    </view>
    <view class="resource-list">
      <view wx:for="{{resources}}" wx:key="key" class="resource-item">
        <view class="resource-info">
          <text class="resource-name">{{item.name}}</text>
          <text class="resource-url">{{item.url}}</text>
          <text wx:if="{{item.passcode}}" class="resource-code">提取码：{{item.passcode}}</text>
        </view>
        <button class="resource-copy" data-index="{{index}}" bindtap="copyResource">复制</button>
      </view>
    </view>
    <text class="delivery-note">网盘资源如有更新，将继续在本页面提供最新地址。</text>
  </view>

  <view wx:for="{{products}}" wx:key="key" wx:if="{{!loading && !error}}" class="purchase-card">
    <view class="purchase-head">
      <text class="purchase-title">{{item.name}}</text>
      <text class="purchase-price">{{item.priceText}}</text>
    </view>
    <view wx:if="{{item.entitlementType === 'unlimited_permanent'}}" class="feature-list">
      <text>购买后获得全部壁纸资源</text>
      <text>一次购买，永久有效</text>
      <text>资源更新后仍可在这里查看</text>
      <text>享会员求图权益，每月可免费提交</text>
    </view>
    <text wx:else class="purchase-desc">{{item.description}}</text>
    <button class="purchase-button" data-key="{{item.key}}" bindtap="buyAll" loading="{{payingKey === item.key}}" disabled="{{paying}}">{{payingKey === item.key ? '购买中' : (item.entitlementType === 'unlimited_permanent' ? '立即开通永久权益' : '立即购买')}}</button>
  </view>

  <view wx:if="{{!loading && !error && !purchased && !products.length}}" class="state-card">
    <text>虚拟支付商品暂未配置</text>
  </view>
</view>
