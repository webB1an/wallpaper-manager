.collections-page{padding:36rpx 30rpx;background:#fbf7f0;min-height:100vh}.collections-heading{padding:12rpx 4rpx 36rpx}.eyebrow{display:block;font-size:18rpx;letter-spacing:4rpx;color:#ad957d}.title{display:block;font-size:40rpx;font-weight:600;color:#46372c;margin:18rpx 0}.subtitle{display:block;font-size:24rpx;line-height:1.8;color:#9b8876}.collection-card{border-radius:24rpx;overflow:hidden;background:#fff;margin-bottom:30rpx;border:1rpx solid #eee3d5}.collection-cover{width:100%;height:320rpx;display:block}.collection-info{padding:28rpx}.collection-date{display:block;font-size:20rpx;color:#a58f79;letter-spacing:2rpx}.collection-title{display:block;font-size:32rpx;line-height:1.6;font-weight:600;color:#47372c;margin:14rpx 0}.collection-intro{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:24rpx;line-height:1.8;color:#998574}.collection-open{display:block;font-size:23rpx;color:#bc612c;margin-top:22rpx}.state{padding:40rpx 20rpx;text-align:center;font-size:26rpx;color:#a38d77;line-height:1.8}.state text{display:block}.state button{margin-top:24rpx;width:180rpx;color:#b96331;font-size:26rpx}.state.small{font-size:22rpx}
