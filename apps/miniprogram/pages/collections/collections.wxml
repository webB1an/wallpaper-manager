<view class="collections-page">
  <view class="collections-heading"><text class="eyebrow">WALLPAPER JOURNAL</text><text class="title">每一期，都值得收藏。</text><text class="subtitle">公众号分享过的壁纸，在这里按篇整理。</text></view>
  <view wx:for="{{items}}" wx:key="id" class="collection-card" bindtap="openCollection" data-id="{{item.id}}">
    <image class="collection-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
    <view class="collection-info"><text class="collection-date">{{item.dateLabel}} · {{item.count}} 张壁纸</text><text class="collection-title">{{item.title}}</text><text class="collection-intro">{{item.intro}}</text><text class="collection-open">查看本期壁纸 ›</text></view>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载合集…</view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button bindtap="retry">重试</button></view>
  <view wx:elif="{{!items.length}}" class="state">还没有公开的文章合集，稍后再来看看。</view>
  <view wx:elif="{{items.length >= total}}" class="state small">已经看完全部合集</view>
</view>
