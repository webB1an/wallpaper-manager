<view class="detail-page" wx:if="{{item}}">
  <view class="detail-visual">
    <image class="detail-cover" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="detail-visual-meta">
      <text>{{typeText}}</text>
      <text>{{item.downloadCount}} 次下载</text>
    </view>
  </view>
  <view class="detail-panel">
    <text class="detail-title">{{item.title}}</text>
    <view class="detail-meta">
      <text>{{typeText}}</text>
      <text>{{sizeText}}</text>
      <text>{{item.downloadCount}} 次下载</text>
    </view>
    <view class="tag-row">
      <block wx:for="{{item.tags}}" wx:key="*this">
        <text class="tag">{{item}}</text>
      </block>
    </view>
    <button class="share-button" open-type="share">分享壁纸</button>
    <view class="primary-download">
      <view>
        <text>原图短链</text>
        <text wx:if="{{primaryUrl}}">{{primaryUrl}}</text>
        <text wx:else>暂无可用短链</text>
      </view>
      <button bindtap="copyPrimaryLink">复制主链</button>
    </view>
    <view class="download-list">
      <view class="download-heading">
        <text>可用网盘</text>
        <text>复制后到浏览器或网盘打开</text>
      </view>
      <block wx:for="{{item.shortLinks}}" wx:key="url">
        <view class="download-card">
          <view>
            <text class="download-label">{{item.label}}</text>
            <text class="download-url">{{item.url}}</text>
          </view>
          <button class="download-button" data-url="{{item.url}}" data-label="{{item.label}}" bindtap="copyLink">复制</button>
        </view>
      </block>
    </view>
    <view wx:if="{{item.related.length}}" class="related-section">
      <view class="related-head">
        <text>继续看看</text>
        <text>{{item.related.length}} 张</text>
      </view>
      <scroll-view scroll-x class="related-scroll" enhanced show-scrollbar="{{false}}">
        <block wx:for="{{item.related}}" wx:key="id">
          <view class="related-card" bindtap="openRelated" data-id="{{item.id}}">
            <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
            <text>{{item.title}}</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
<view wx:elif="{{error}}" class="empty detail-empty">
  <text>{{error}}</text>
  <button class="retry-button" bindtap="retry">重试</button>
</view>
<view wx:else class="empty detail-empty">加载中...</view>
