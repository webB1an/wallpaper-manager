<view class="detail-page" wx:if="{{item}}">
  <view class="detail-topbar">
    <view class="detail-back" catchtap="goBack" style="top:{{capsuleTop}}px;width:{{capsuleHeight}}px;height:{{capsuleHeight}}px;"><image class="detail-back-icon" src="/assets/icons/back.png" /></view>
  </view>
  <view class="detail-visual">
    <image class="detail-cover" src="{{item.coverUrl}}" mode="aspectFill" />
  </view>
  <view class="detail-panel">
    <view class="detail-title-row">
      <text class="detail-title">{{item.title}}</text>
      <view class="fav-button" bindtap="toggleFav">
        <text class="fav-heart {{fav ? 'on' : ''}}">{{fav ? '♥' : '♡'}}</text>
      </view>
      <!-- 直接下载按钮暂时隐藏 -->
      <view class="download-button" bindtap="onDownload" wx:if="{{false}}">
        <image class="download-icon" src="/assets/icons/download.png" />
        <text class="download-text">下载</text>
      </view>
    </view>
    <view class="detail-meta">
      <text>{{typeText}}</text>
      <text wx:if="{{orientationText}}">{{orientationText}}</text>
      <text>{{sizeText}}</text>
      <text>{{item.downloadCount}} 次下载</text>
    </view>
    <view class="tag-row">
      <block wx:for="{{item.tags}}" wx:key="*this">
        <text class="tag" bindtap="openTag" data-tag="{{item}}">{{item}}</text>
      </block>
    </view>
    <view wx:if="{{isAdmin}}" class="admin-bar">
      <button class="admin-offline-btn" bindtap="offlineWallpaper">下架</button>
    </view>
    <view class="primary-download">
      <view>
        <text>壁纸资源</text>
        <text wx:if="{{primaryUrl}}">{{primaryUrl}}</text>
        <text wx:else>暂无可用短链</text>
        <text wx:if="{{primaryPasscode}}" class="primary-passcode">提取码 {{primaryPasscode}}</text>
      </view>
      <button class="{{primaryLink ? '' : 'disabled'}}" disabled="{{!primaryLink}}" bindtap="copyPrimaryLink">{{primaryLink ? '复制链接' : '暂无短链'}}</button>
    </view>
    <view wx:if="{{paymentProducts.length}}" class="paid-download-card">
      <view class="paid-download-main">
        <text class="paid-download-title">永久下载权益</text>
        <text class="paid-download-desc">{{paymentProducts[0].name}} · {{paymentProducts[0].priceText}}</text>
      </view>
      <button class="paid-download-button" bindtap="onPaidDownload" loading="{{paying}}">{{paying ? '支付中' : '开通永久'}}</button>
    </view>
    <view wx:if="{{paymentProducts.length}}" class="paid-download-note">Android/鸿蒙技术服务费 1%，iOS 佣金 12%；iOS 退款由 App Store 处理。</view>
    <ad wx:if="{{adUnit}}" class="detail-ad" unit-id="{{adUnit}}" binderror="onAdError" />
    <view wx:if="{{item.related.length}}" class="related-section">
      <view class="related-head">
        <text>继续看看</text>
        <text>{{item.related.length}} 张</text>
      </view>
      <view class="related-grid">
        <block wx:for="{{item.related}}" wx:key="id">
          <view class="related-card" bindtap="openRelated" data-id="{{item.id}}">
            <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
            <text>{{item.title}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
<view wx:elif="{{error}}" class="empty detail-empty state-card">
  <view class="detail-topbar">
    <view class="detail-back" catchtap="goBack" style="top:{{capsuleTop}}px;width:{{capsuleHeight}}px;height:{{capsuleHeight}}px;"><image class="detail-back-icon" src="/assets/icons/back.png" /></view>
  </view>
  <text>{{error}}</text>
  <button wx:if="{{id}}" class="retry-button" bindtap="retry">重试</button>
  <button wx:else class="retry-button" bindtap="goHome">回首页</button>
</view>
<view wx:else class="detail-page detail-loading">
  <view class="detail-topbar">
    <view class="detail-back" catchtap="goBack" style="top:{{capsuleTop}}px;width:{{capsuleHeight}}px;height:{{capsuleHeight}}px;"><image class="detail-back-icon" src="/assets/icons/back.png" /></view>
  </view>
  <view class="detail-cover-skeleton"></view>
  <view class="detail-panel detail-panel-skeleton">
    <view class="skeleton-line title"></view>
    <view class="skeleton-line meta"></view>
    <view class="skeleton-line tag"></view>
    <view class="skeleton-action"></view>
    <view class="skeleton-download"></view>
    <view class="skeleton-download small"></view>
  </view>
</view>
<view wx:if="{{toastText}}" class="custom-toast">{{toastText}}</view>
<view wx:if="{{downloading}}" class="download-loading">
  <view class="download-loading-box">
    <view class="download-spinner"></view>
    <text>{{downloadMessage}}</text>
  </view>
</view>
<view wx:if="{{showRewardGuide}}" class="reward-guide">
  <view class="reward-guide-title">解锁下载权限</view>
  <view class="reward-guide-body">{{rewardModalText}}</view>
  <view class="reward-guide-actions">
    <button class="reward-guide-btn cancel" bindtap="onRewardCancel">取消</button>
    <button class="reward-guide-btn confirm" bindtap="onRewardConfirm">去观看</button>
    <button wx:if="{{paymentProducts.length}}" class="reward-guide-btn confirm paid" bindtap="onPaidDownload">开通永久</button>
  </view>
</view>
<view wx:if="{{showAlbumGuide}}" class="album-guide">
  <text>保存壁纸需要相册权限</text>
  <button class="album-guide-btn" bindtap="openAlbumSetting">去开启权限</button>
</view>
