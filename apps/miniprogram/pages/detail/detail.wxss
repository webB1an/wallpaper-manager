.detail-page {
  min-height: 100vh;
  background: #111820;
}

.detail-visual {
  position: relative;
  overflow: hidden;
  height: 720rpx;
  background: #111820;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 720rpx;
  background: #27332d;
}

.detail-visual::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 260rpx;
  content: "";
  background: linear-gradient(180deg, rgba(17, 24, 32, 0), rgba(17, 24, 32, 0.92));
}

.detail-visual-meta {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 46rpx;
  left: 28rpx;
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.detail-visual-meta text {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
  background: rgba(17, 24, 32, 0.36);
}

.detail-panel {
  position: relative;
  z-index: 3;
  margin-top: -32rpx;
  padding: 34rpx 28rpx 60rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #f4f6f1;
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.35;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #6d7a72;
  font-size: 24rpx;
}

.tag-row {
  margin-top: 24rpx;
}

.share-button {
  width: 100%;
  height: 76rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #25465a;
  font-size: 27rpx;
  font-weight: 780;
  line-height: 76rpx;
}

.share-button::after {
  border: 0;
}

.download-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-download {
  display: grid;
  grid-template-columns: 1fr 170rpx;
  gap: 16rpx;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(255, 209, 102, 0.16), transparent 44%),
    #111820;
  box-shadow: 0 14rpx 34rpx rgba(17, 24, 32, 0.14);
}

.primary-download view text:first-child {
  display: block;
  color: #ffd166;
  font-size: 23rpx;
  font-weight: 780;
}

.primary-download view text:last-child {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-download button {
  height: 72rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #111820;
  background: #ffd166;
  font-size: 25rpx;
  font-weight: 820;
  line-height: 72rpx;
}

.primary-download button::after {
  border: 0;
}

.download-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  color: #111820;
  font-size: 29rpx;
  font-weight: 820;
}

.download-heading text:last-child {
  color: #7d887f;
  font-size: 22rpx;
  font-weight: 520;
}

.download-card {
  display: grid;
  grid-template-columns: 1fr 136rpx;
  gap: 14rpx;
  align-items: center;
  padding: 18rpx;
  border: 2rpx solid #dce4e8;
  border-radius: 14rpx;
  background: #fff;
}

.download-empty {
  padding: 26rpx 18rpx;
  border: 2rpx dashed #dce4e8;
  border-radius: 14rpx;
  color: #7d887f;
  background: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  text-align: center;
}

.download-label {
  display: block;
  color: #111820;
  font-size: 28rpx;
  font-weight: 760;
}

.download-url {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #68727c;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-passcode {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  color: #25465a;
  background: #edf4f0;
  font-size: 21rpx;
  font-weight: 760;
}

.download-button {
  height: 70rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #d85a3a;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 70rpx;
}

.related-section {
  margin-top: 42rpx;
}

.related-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.related-head text:first-child {
  color: #111820;
  font-size: 31rpx;
  font-weight: 820;
}

.related-head text:last-child {
  color: #7d887f;
  font-size: 23rpx;
}

.related-scroll {
  width: 100%;
  white-space: nowrap;
}

.related-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 18rpx;
  overflow: hidden;
  vertical-align: top;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 32, 0.06);
}

.related-card image {
  display: block;
  width: 220rpx;
  height: 144rpx;
  background: #dce4e8;
}

.related-card text {
  display: block;
  height: 68rpx;
  padding: 12rpx;
  overflow: hidden;
  color: #111820;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 34rpx;
  white-space: normal;
}
