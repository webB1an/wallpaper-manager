.detail-page {
  position: relative;
  min-height: 100vh;
  background: #fbf7f0;
}

.detail-topbar {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: calc(env(safe-area-inset-top) + 8rpx) 20rpx 0;
  background: transparent;
}

.detail-back {
  position: absolute;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.28);
}

.detail-back-icon {
  width: 48rpx;
  height: 48rpx;
}

.detail-visual {
  position: relative;
  overflow: hidden;
  height: 720rpx;
  background: #2b211b;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 720rpx;
  background: #2b211b;
}

.detail-visual::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 260rpx;
  content: "";
  background: linear-gradient(180deg, rgba(29, 37, 33, 0), rgba(29, 37, 33, 0.94));
}

.detail-panel {
  position: relative;
  z-index: 3;
  margin-top: -32rpx;
  padding: 34rpx 28rpx 60rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fbf7f0;
}

.detail-panel view,
.detail-panel text {
  min-width: 0;
}

.detail-panel::before {
  display: block;
  width: 64rpx;
  height: 8rpx;
  margin: -10rpx auto 24rpx;
  border-radius: 999rpx;
  content: "";
  background: #e8ddcd;
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.35;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #8a7668;
  font-size: 24rpx;
}

.tag-row {
  margin-top: 24rpx;
}

.share-button {
  width: 100%;
  max-width: 100%;
  height: 76rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 27rpx;
  font-weight: 780;
  line-height: 76rpx;
}

.share-button::after {
  border: 0;
}

.download-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-download {
  display: grid;
  grid-template-columns: 1fr 170rpx;
  gap: 16rpx;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(230, 181, 102, 0.2), transparent 46%),
    #2b211b;
  box-shadow: 0 14rpx 34rpx rgba(29, 37, 33, 0.18);
}

.primary-download > view {
  min-width: 0;
}

.primary-download view text:first-child {
  display: block;
  color: #e8b87b;
  font-size: 23rpx;
  font-weight: 780;
}

.primary-download view text:nth-child(2) {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-passcode {
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  color: #2b211b;
  background: #e8b87b;
  font-size: 21rpx;
  font-weight: 820;
}

.primary-download button {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #2b211b;
  background: #e8b87b;
  font-size: 25rpx;
  font-weight: 820;
  line-height: 72rpx;
}

.primary-download button::after {
  border: 0;
}

.primary-download button.disabled {
  color: rgba(29, 37, 33, 0.46);
  background: rgba(255, 255, 255, 0.42);
}

.download-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  color: #2b211b;
  font-size: 29rpx;
  font-weight: 820;
}

.download-heading text:last-child {
  color: #8a7668;
  font-size: 22rpx;
  font-weight: 520;
}

.download-card {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 136rpx;
  gap: 14rpx;
  align-items: center;
  padding: 18rpx;
  border: 2rpx solid #efe4d6;
  border-radius: 10rpx;
  background: #ffffff;
}

.download-card > view {
  min-width: 0;
}

.download-card::before {
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 6rpx;
  height: 70rpx;
  border-radius: 0 999rpx 999rpx 0;
  content: "";
  background: #c05621;
}

.download-empty {
  padding: 26rpx 18rpx;
  border: 2rpx dashed #efe4d6;
  border-radius: 14rpx;
  color: #8a7668;
  background: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  text-align: center;
}

.download-label {
  display: block;
  color: #2b211b;
  font-size: 28rpx;
  font-weight: 760;
}

.download-url {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #8a7668;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-passcode {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 21rpx;
  font-weight: 760;
}

.download-button {
  width: 100%;
  min-width: 0;
  height: 70rpx;
  padding: 0;
  border-radius: 10rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 70rpx;
}

.related-section {
  margin-top: 42rpx;
}

.detail-ad {
  margin-top: 28rpx;
}

.related-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.related-head text:first-child {
  color: #2b211b;
  font-size: 31rpx;
  font-weight: 820;
}

.related-head text:last-child {
  color: #8a7668;
  font-size: 23rpx;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  width: 100%;
}

.related-card {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(29, 37, 33, 0.06);
}

.related-card image {
  display: block;
  width: 100%;
  height: 210rpx;
  background: #f0e4d6;
}

.related-card text {
  display: block;
  height: 44rpx;
  padding: 0 12rpx;
  overflow: hidden;
  color: #2b211b;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-loading {
  background: #2b211b;
}

.detail-cover-skeleton {
  height: 720rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0)),
    #2b211b;
  background-size: 260rpx 100%, 100% 100%;
  animation: detailSkeletonSweep 1.4s ease-in-out infinite;
}

.detail-panel-skeleton {
  min-height: 560rpx;
}

.skeleton-line,
.skeleton-action,
.skeleton-download {
  border-radius: 999rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 220rpx 100%, 100% 100%;
  animation: detailPanelSkeletonSweep 1.4s ease-in-out infinite;
}

.skeleton-line.title {
  width: 76%;
  height: 42rpx;
}

.skeleton-line.meta {
  width: 48%;
  height: 24rpx;
  margin-top: 24rpx;
}

.skeleton-line.tag {
  width: 64%;
  height: 34rpx;
  margin-top: 26rpx;
}

.skeleton-action {
  width: 100%;
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 14rpx;
}

.skeleton-download {
  height: 118rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
}

.skeleton-download.small {
  height: 96rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
}

@keyframes detailSkeletonSweep {
  0% {
    background-position: -280rpx 0, 0 0;
  }
  100% {
    background-position: 760rpx 0, 0 0;
  }
}

@keyframes detailPanelSkeletonSweep {
  0% {
    background-position: -240rpx 0, 0 0;
  }
  100% {
    background-position: 720rpx 0, 0 0;
  }
}
