.detail-page {
  min-height: 100vh;
  background: #111820;
}

.detail-cover {
  display: block;
  width: 100%;
  min-height: 460rpx;
  background: #27332d;
}

.detail-panel {
  margin-top: -28rpx;
  padding: 34rpx 28rpx 60rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #f4f6f1;
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.35;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #6d7a72;
  font-size: 24rpx;
}

.tag-row {
  margin-top: 24rpx;
}

.share-button {
  width: 100%;
  height: 76rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #25465a;
  font-size: 27rpx;
  font-weight: 780;
  line-height: 76rpx;
}

.share-button::after {
  border: 0;
}

.download-list {
  display: grid;
  gap: 16rpx;
  margin-top: 30rpx;
}

.download-card {
  display: grid;
  grid-template-columns: 1fr 136rpx;
  gap: 14rpx;
  align-items: center;
  padding: 18rpx;
  border: 2rpx solid #dce4e8;
  border-radius: 14rpx;
  background: #fff;
}

.download-label {
  display: block;
  color: #111820;
  font-size: 28rpx;
  font-weight: 760;
}

.download-url {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #68727c;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-button {
  height: 70rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #d85a3a;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 70rpx;
}

.related-section {
  margin-top: 42rpx;
}

.related-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.related-head text:first-child {
  color: #111820;
  font-size: 31rpx;
  font-weight: 820;
}

.related-head text:last-child {
  color: #7d887f;
  font-size: 23rpx;
}

.related-scroll {
  width: 100%;
  white-space: nowrap;
}

.related-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 18rpx;
  overflow: hidden;
  vertical-align: top;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 32, 0.06);
}

.related-card image {
  display: block;
  width: 220rpx;
  height: 144rpx;
  background: #dce4e8;
}

.related-card text {
  display: block;
  height: 68rpx;
  padding: 12rpx;
  overflow: hidden;
  color: #111820;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 34rpx;
  white-space: normal;
}
