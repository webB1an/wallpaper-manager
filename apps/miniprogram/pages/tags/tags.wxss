.page {
  padding: 28rpx 32rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #2b211b;
  font-size: 28rpx;
}

.search-button {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #e57355, #c05621);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.tag-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #2b211b;
  font-size: 26rpx;
}

.tag-chip:active {
  opacity: 0.85;
}

.tag-chip-count {
  color: #c05621;
  font-size: 22rpx;
}

.load-hint {
  padding: 24rpx 0;
  color: #a89484;
  font-size: 24rpx;
  text-align: center;
}

.load-more {
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-radius: 16rpx;
  background: #fff;
  color: #c05621;
  font-size: 28rpx;
  text-align: center;
}
