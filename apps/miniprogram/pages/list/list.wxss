.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 4rpx 20rpx;
}

.list-head > view {
  min-width: 0;
}

.list-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #2f6f5e;
  font-size: 26rpx;
  font-weight: 820;
}

.list-title {
  color: #1e2823;
  font-size: 42rpx;
  font-weight: 860;
  line-height: 1.2;
}

.list-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #6b7a72;
  font-size: 24rpx;
}

.list-count {
  flex-shrink: 0;
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 760;
}

.masonry-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.masonry-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.poster-card {
  overflow: hidden;
  width: 100%;
  border: 1rpx solid #e7ece7;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 28, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  min-height: 300rpx;
  height: auto;
  background: #e6ebe6;
}

.poster-body {
  padding: 16rpx;
}

.poster-title {
  display: block;
  height: 68rpx;
  overflow: hidden;
  color: #1e2823;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #6b7a72;
  font-size: 21rpx;
}

.poster-pill {
  flex-shrink: 0;
  color: #2f6f5e;
  font-weight: 760;
}

.skeleton-card {
  width: 100%;
  height: 430rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0)),
    #e6ebe6;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
