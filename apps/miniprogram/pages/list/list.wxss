.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 4rpx 20rpx;
}

.list-head > view {
  min-width: 0;
}

.list-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 26rpx;
  font-weight: 820;
}

.list-title {
  color: #2b211b;
  font-size: 42rpx;
  font-weight: 860;
  line-height: 1.2;
}

.list-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #8a7668;
  font-size: 24rpx;
}

.list-count {
  flex-shrink: 0;
  color: #c05621;
  font-size: 24rpx;
  font-weight: 760;
}

.masonry-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.masonry-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.poster-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  border: 1rpx solid #efe4d6;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 28, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  height: auto;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: cardShimmer 1.4s ease-in-out infinite;
}

.poster-info {
  padding: 16rpx;
}

.poster-title {
  display: block;
  overflow: hidden;
  color: #2b211b;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  color: #8a7668;
  font-size: 21rpx;
}

.pill {
  display: inline-block;
  margin-top: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 21rpx;
}

.count {
  display: inline-block;
  max-width: 170rpx;
  margin-top: 0;
  margin-left: 0;
  overflow: hidden;
  color: #8a7668;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  min-width: 48rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(192, 86, 33, 0.96);
  font-size: 19rpx;
  font-weight: 760;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #6d5c4f;
  background: #faf1e7;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skeleton-card {
  width: 100%;
  height: 430rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}

@keyframes cardShimmer {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
