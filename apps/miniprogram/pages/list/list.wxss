.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 4rpx 20rpx;
}

.list-head > view {
  min-width: 0;
}

.list-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  color: #fff;
  background: #7a4f2b;
  font-size: 26rpx;
  font-weight: 820;
}

.list-title {
  color: #2a2a22;
  font-size: 42rpx;
  font-weight: 860;
  line-height: 1.2;
}

.list-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #77766e;
  font-size: 24rpx;
}

.list-count {
  flex-shrink: 0;
  color: #7a4f2b;
  font-size: 24rpx;
  font-weight: 760;
}

.poster-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.poster-card {
  overflow: hidden;
  border: 1rpx solid #e5e0d2;
  border-radius: 18rpx;
  background: #fffdf7;
  box-shadow: 0 12rpx 30rpx rgba(42, 42, 34, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  height: 430rpx;
  background: #e8e2d2;
}

.poster-body {
  padding: 16rpx;
}

.poster-title {
  display: block;
  height: 68rpx;
  overflow: hidden;
  color: #2a2a22;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #8a8174;
  font-size: 21rpx;
}

.poster-pill {
  flex-shrink: 0;
  color: #3f5c40;
  font-weight: 760;
}
