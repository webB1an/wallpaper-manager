<template name="listPosterCard">
  <view class="poster-card" bindtap="openDetail" data-id="{{item.id}}">
    <image src="{{item.coverUrl}}" mode="widthFix" lazy-load />
    <view class="poster-body">
      <text class="poster-title">{{item.title}}</text>
      <view class="poster-meta">
        <text class="poster-pill">{{item.type === 'live' ? '▶ 动态' : '● 静态'}}</text>
        <text>{{item.downloadCount}} 次</text>
      </view>
    </view>
  </view>
</template>

<view class="page list-page">
  <view class="list-head">
    <view>
      <text class="list-icon">#</text>
      <text class="list-title">{{title}}</text>
      <text class="list-subtitle">{{subtitle}}</text>
    </view>
    <text class="list-count">{{total}} 张</text>
  </view>

  <view class="poster-grid masonry-grid">
    <view class="masonry-column">
      <block wx:for="{{leftItems}}" wx:key="id">
        <template is="listPosterCard" data="{{item}}" />
      </block>
    </view>
    <view class="masonry-column">
      <block wx:for="{{rightItems}}" wx:key="id">
        <template is="listPosterCard" data="{{item}}" />
      </block>
    </view>
  </view>

  <view wx:if="{{loading && items.length === 0}}" class="masonry-grid">
    <view class="masonry-column">
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
    </view>
    <view class="masonry-column">
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
    </view>
  </view>
  <view wx:elif="{{loading && items.length > 0}}" class="loading-more">继续加载...</view>
  <view wx:elif="{{!loading && error}}" class="empty state-card">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!loading && items.length === 0}}" class="empty state-card">
    <text>暂无壁纸</text>
    <text class="empty-subtitle">换个标签或类型再看看</text>
  </view>
</view>
