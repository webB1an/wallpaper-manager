.hero {
  overflow: hidden;
  padding: 0;
  border: 0;
  border-radius: 26rpx;
  background: transparent;
  box-shadow: none;
}

.hero-fallback {
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #c05621 0%, #8a5a34 100%);
  box-shadow: 0 18rpx 42rpx rgba(49, 74, 59, 0.2);
}

.hero-swiper {
  height: 420rpx;
}

.hero-slide {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.hero-slide image {
  display: block;
  width: 100%;
  height: 420rpx;
  background: #f0e4d6;
  filter: saturate(0.96) contrast(1);
}

.hero-slide::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, rgba(31, 35, 28, 0.06), rgba(31, 35, 28, 0.8));
}

.hero-overlay {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 50rpx;
  left: 28rpx;
}

.hero-fallback {
  padding: 42rpx 32rpx;
  color: #ffffff;
}

.hero-kicker {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2b211b;
  background: #e8b87b;
  font-size: 20rpx;
  font-weight: 820;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  max-width: 560rpx;
  margin-top: 16rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 860;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-meta text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(31, 35, 28, 0.42);
  font-size: 22rpx;
}

.search-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 22rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid #efe4d6;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 35, 28, 0.06);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: transparent;
  color: #2b211b;
  font-size: 27rpx;
}

.search-button {
  flex: 0 0 76rpx;
  width: 76rpx;
  max-width: 76rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hot-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 23rpx;
}

.filter {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #efe4d6;
  border-radius: 999rpx;
  color: #6d5c4f;
  background: #ffffff;
  font-size: 25rpx;
}

.filter.active {
  border-color: #2b211b;
  color: #ffffff;
  background: #2b211b;
  font-weight: 760;
}

.filter text {
  font-size: 30rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.tag-filter {
  padding: 15rpx 22rpx;
  border-radius: 999rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 24rpx;
}

.gallery-head {
  margin-bottom: 18rpx;
}

.masonry-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.masonry-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.poster-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  border: 1rpx solid #efe4d6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 35, 28, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  height: auto;
  background: #f0e4d6;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(184, 92, 62, 0.96);
  font-size: 19rpx;
  font-weight: 760;
}

.poster-info {
  padding: 16rpx;
}

.poster-title {
  display: block;
  height: 68rpx;
  overflow: hidden;
  color: #2b211b;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
}

.pill {
  display: inline-block;
  margin-top: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 21rpx;
}

.poster-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.count {
  display: inline-block;
  max-width: 170rpx;
  margin-top: 0;
  margin-left: 0;
  overflow: hidden;
  color: #8a7668;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #6d5c4f;
  background: #faf1e7;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skeleton-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 6rpx;
}

.skeleton-grid .masonry-column {
  flex: 1;
}

.skeleton-card {
  height: 500rpx;
  width: 100%;
  padding: 18rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

.skeleton-card.tall {
  height: 500rpx;
}

.skeleton-card text {
  display: block;
  width: 70%;
  height: 22rpx;
  margin-top: 410rpx;
  border-radius: 999rpx;
  background: rgba(31, 35, 28, 0.08);
}

.skeleton-card.tall text {
  margin-top: 410rpx;
}

.skeleton-card text:last-child {
  width: 42%;
  margin-top: 14rpx;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
