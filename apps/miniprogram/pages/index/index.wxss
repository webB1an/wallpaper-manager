.hero-kicker {
  color: #ffd166;
  font-size: 22rpx;
  font-weight: 700;
}

.hero {
  display: grid;
  grid-template-columns: 1fr 210rpx;
  min-height: 286rpx;
  gap: 18rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero-stack {
  position: relative;
  z-index: 1;
  height: 232rpx;
  align-self: center;
}

.hero-shot {
  position: absolute;
  width: 152rpx;
  height: 196rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 10rpx;
  background: #263840;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.24);
}

.shot-0 {
  z-index: 3;
  top: 12rpx;
  right: 48rpx;
  transform: rotate(-7deg);
}

.shot-1 {
  z-index: 2;
  top: 34rpx;
  right: 0;
  transform: rotate(8deg);
}

.shot-2 {
  z-index: 1;
  top: 0;
  right: 94rpx;
  opacity: 0.78;
  transform: rotate(-14deg);
}

.hero-meter {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-meter text:first-child {
  color: #ffd166;
  font-size: 34rpx;
  font-weight: 820;
}

.hero-meter text:last-child {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr 138rpx;
  gap: 14rpx;
  margin-top: 24rpx;
}

.search-input {
  height: 78rpx;
  padding: 0 26rpx;
  border-radius: 10rpx;
  background: #fff;
  font-size: 27rpx;
  box-shadow: inset 0 0 0 2rpx #e7e5db;
}

.search-button {
  height: 78rpx;
  padding: 0;
  border-radius: 10rpx;
  color: #fff;
  background: #dd6b45;
  font-size: 27rpx;
  line-height: 78rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.filter {
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  color: #66717b;
  background: #fff;
  font-size: 25rpx;
}

.filter.active {
  color: #111820;
  background: #ffd679;
  font-weight: 700;
}

.tag-filter {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #245167;
  background: #deeaeb;
  font-size: 24rpx;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.type-filter {
  min-width: 108rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dbe4e8;
  border-radius: 10rpx;
  color: #304653;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
}

.type-filter.active {
  border-color: #245167;
  color: #fff;
  background: #245167;
  font-weight: 700;
}

.gallery-labels {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin: -6rpx 0 18rpx;
}

.gallery-labels text {
  position: relative;
  height: 48rpx;
  padding-left: 24rpx;
  border-radius: 8rpx;
  color: #68727c;
  background: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
  line-height: 48rpx;
}

.gallery-labels text::before {
  position: absolute;
  top: 18rpx;
  left: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  content: "";
  background: #dd6b45;
}

.masonry {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.wall-card {
  position: relative;
  overflow: hidden;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(24, 34, 29, 0.08);
}

.wall-card image {
  display: block;
  width: 100%;
  height: 244rpx;
  background: #dce4e8;
}

.wall-card:nth-child(4n + 1) image {
  height: 306rpx;
}

.wall-card:nth-child(4n + 3) image {
  height: 276rpx;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(221, 107, 69, 0.94);
  font-size: 20rpx;
  font-weight: 820;
}

.wall-info {
  padding: 16rpx;
}

.wall-title {
  display: block;
  height: 68rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #245167;
  background: #deeaeb;
  font-size: 21rpx;
}

.count {
  float: right;
  margin-top: 14rpx;
  color: #8a949b;
  font-size: 21rpx;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #66717b;
  background: #f0f3ee;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 6rpx;
}

.skeleton-card {
  height: 324rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0)),
    #e8ece7;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

.skeleton-card.tall {
  height: 386rpx;
}

.skeleton-card text {
  display: block;
  width: 70%;
  height: 22rpx;
  margin-top: 238rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 32, 0.08);
}

.skeleton-card.tall text {
  margin-top: 300rpx;
}

.skeleton-card text:last-child {
  width: 42%;
  margin-top: 14rpx;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
