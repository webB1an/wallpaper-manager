.hero-kicker {
  color: #e3c35e;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero {
  display: grid;
  grid-template-columns: 1fr 230rpx;
  min-height: 300rpx;
  gap: 18rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.hero-stack {
  position: relative;
  z-index: 1;
  height: 246rpx;
  align-self: center;
}

.hero-shot {
  position: absolute;
  width: 160rpx;
  height: 214rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 18rpx;
  background: #30382f;
  filter: saturate(0.86) contrast(0.96);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.28);
}

.shot-0 {
  z-index: 3;
  top: 12rpx;
  right: 50rpx;
  transform: rotate(-5deg);
}

.shot-1 {
  z-index: 2;
  top: 34rpx;
  right: 0;
  transform: rotate(7deg);
}

.shot-2 {
  z-index: 1;
  top: 0;
  right: 104rpx;
  opacity: 0.78;
  transform: rotate(-12deg);
}

.hero-meter {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  width: fit-content;
  margin-top: 28rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-meter text:first-child {
  color: #e3c35e;
  font-size: 34rpx;
  font-weight: 820;
}

.hero-meter text:last-child {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.search-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 22rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 2rpx solid #e1dfd7;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(32, 36, 31, 0.06);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: transparent;
  font-size: 27rpx;
}

.search-button {
  flex: 0 0 108rpx;
  width: 108rpx;
  max-width: 108rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #2f4b3f;
  font-size: 26rpx;
  font-weight: 760;
  line-height: 68rpx;
  text-align: center;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.filter {
  padding: 15rpx 26rpx;
  border-radius: 999rpx;
  color: #616960;
  background: #fff;
  font-size: 25rpx;
}

.filter.active {
  color: #fff;
  background: #20241f;
  font-weight: 700;
}

.tag-filter {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #2f4b3f;
  background: #e6ebe2;
  font-size: 24rpx;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.type-filter {
  min-width: 100rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #dfddd4;
  border-radius: 16rpx;
  color: #3d4641;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
}

.type-filter.active {
  border-color: #2f4b3f;
  color: #fff;
  background: #2f4b3f;
  font-weight: 700;
}

.gallery-head {
  margin-bottom: 18rpx;
}

.masonry {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.wall-card {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 14rpx 36rpx rgba(32, 36, 31, 0.08);
}

.wall-card image {
  display: block;
  width: 100%;
  height: 266rpx;
  background: #e2e6dd;
}

.wall-card:nth-child(4n + 1) image {
  height: 330rpx;
}

.wall-card:nth-child(4n + 3) image {
  height: 300rpx;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(181, 92, 59, 0.94);
  font-size: 20rpx;
  font-weight: 820;
}

.wall-info {
  padding: 18rpx;
}

.wall-title {
  display: block;
  min-height: 66rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #2f4b3f;
  background: #e6ebe2;
  font-size: 21rpx;
}

.count {
  display: inline-block;
  max-width: 180rpx;
  margin-top: 14rpx;
  margin-left: 10rpx;
  overflow: hidden;
  color: #8a949b;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #66717b;
  background: #eff2ea;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 6rpx;
}

.skeleton-card {
  height: 324rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0)),
    #e8ece7;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

.skeleton-card.tall {
  height: 386rpx;
}

.skeleton-card text {
  display: block;
  width: 70%;
  height: 22rpx;
  margin-top: 238rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 32, 0.08);
}

.skeleton-card.tall text {
  margin-top: 300rpx;
}

.skeleton-card text:last-child {
  width: 42%;
  margin-top: 14rpx;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
