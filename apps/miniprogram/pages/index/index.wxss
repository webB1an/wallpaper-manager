.hero {
  overflow: hidden;
  border: 1rpx solid #e4ddcc;
  border-radius: 26rpx;
  background: #2a2a22;
  box-shadow: 0 18rpx 42rpx rgba(42, 42, 34, 0.12);
}

.hero-swiper {
  height: 420rpx;
}

.hero-slide {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.hero-slide image {
  display: block;
  width: 100%;
  height: 420rpx;
  background: #e8e2d2;
  filter: saturate(0.92) contrast(0.98);
}

.hero-slide::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, rgba(42, 42, 34, 0.04), rgba(42, 42, 34, 0.78));
}

.hero-overlay {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 28rpx;
  left: 28rpx;
}

.hero-fallback {
  padding: 42rpx 32rpx;
  color: #fffdf7;
}

.hero-kicker {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2a2a22;
  background: #e6c55f;
  font-size: 20rpx;
  font-weight: 820;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  max-width: 560rpx;
  margin-top: 16rpx;
  overflow: hidden;
  color: #fffdf7;
  font-size: 42rpx;
  font-weight: 860;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 253, 247, 0.78);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-meta text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: rgba(255, 253, 247, 0.88);
  background: rgba(42, 42, 34, 0.42);
  font-size: 22rpx;
}

.search-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 22rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid #e4ddcc;
  border-radius: 22rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(42, 42, 34, 0.06);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: transparent;
  color: #2a2a22;
  font-size: 27rpx;
}

.search-button {
  flex: 0 0 76rpx;
  width: 76rpx;
  max-width: 76rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 18rpx;
  color: #fffdf7;
  background: #3f5c40;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 68rpx;
  text-align: center;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.filter {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #e4ddcc;
  border-radius: 999rpx;
  color: #686357;
  background: #fffdf7;
  font-size: 25rpx;
}

.filter.active {
  border-color: #2a2a22;
  color: #fffdf7;
  background: #2a2a22;
  font-weight: 760;
}

.filter text {
  font-size: 22rpx;
}

.tag-filter {
  padding: 15rpx 22rpx;
  border-radius: 999rpx;
  color: #3f5c40;
  background: #e7eddf;
  font-size: 24rpx;
}

.gallery-head {
  margin-bottom: 18rpx;
}

.poster-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.poster-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e4ddcc;
  border-radius: 20rpx;
  background: #fffdf7;
  box-shadow: 0 14rpx 34rpx rgba(42, 42, 34, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  height: 430rpx;
  background: #e8e2d2;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  color: #fffdf7;
  background: rgba(122, 79, 43, 0.92);
  font-size: 19rpx;
  font-weight: 820;
}

.poster-info {
  padding: 16rpx;
}

.poster-title {
  display: block;
  height: 68rpx;
  overflow: hidden;
  color: #2a2a22;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
}

.pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #3f5c40;
  background: #e7eddf;
  font-size: 21rpx;
}

.count {
  display: inline-block;
  max-width: 170rpx;
  margin-top: 14rpx;
  margin-left: 10rpx;
  overflow: hidden;
  color: #8a8174;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #77766e;
  background: #f0ede3;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 6rpx;
}

.skeleton-card {
  height: 500rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0)),
    #e8e2d2;
  background-size: 240rpx 100%, 100% 100%;
  animation: skeletonSweep 1.4s ease-in-out infinite;
}

.skeleton-card.tall {
  height: 500rpx;
}

.skeleton-card text {
  display: block;
  width: 70%;
  height: 22rpx;
  margin-top: 410rpx;
  border-radius: 999rpx;
  background: rgba(42, 42, 34, 0.08);
}

.skeleton-card.tall text {
  margin-top: 410rpx;
}

.skeleton-card text:last-child {
  width: 42%;
  margin-top: 14rpx;
}

@keyframes skeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
