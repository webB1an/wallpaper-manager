.hero-kicker {
  color: #ffd166;
  font-size: 22rpx;
  font-weight: 700;
}

.hero {
  display: grid;
  grid-template-columns: 1fr 210rpx;
  min-height: 286rpx;
  gap: 18rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero-stack {
  position: relative;
  z-index: 1;
  height: 232rpx;
  align-self: center;
}

.hero-shot {
  position: absolute;
  width: 152rpx;
  height: 196rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 16rpx;
  background: #263840;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.24);
}

.shot-0 {
  z-index: 3;
  top: 12rpx;
  right: 48rpx;
  transform: rotate(-7deg);
}

.shot-1 {
  z-index: 2;
  top: 34rpx;
  right: 0;
  transform: rotate(8deg);
}

.shot-2 {
  z-index: 1;
  top: 0;
  right: 94rpx;
  opacity: 0.78;
  transform: rotate(-14deg);
}

.hero-meter {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-meter text:first-child {
  color: #ffd166;
  font-size: 34rpx;
  font-weight: 820;
}

.hero-meter text:last-child {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr 138rpx;
  gap: 14rpx;
  margin-top: 24rpx;
}

.search-input {
  height: 78rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background: #fff;
  font-size: 27rpx;
  box-shadow: inset 0 0 0 2rpx #e4e9e1;
}

.search-button {
  height: 78rpx;
  padding: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #d85a3a;
  font-size: 27rpx;
  line-height: 78rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.filter {
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  color: #66717b;
  background: #fff;
  font-size: 25rpx;
}

.filter.active {
  color: #111820;
  background: #ffd166;
  font-weight: 700;
}

.tag-filter {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #25465a;
  background: #dfe9ef;
  font-size: 24rpx;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.type-filter {
  min-width: 108rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dbe4e8;
  border-radius: 12rpx;
  color: #304653;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
}

.type-filter.active {
  border-color: #25465a;
  color: #fff;
  background: #25465a;
  font-weight: 700;
}

.masonry {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.wall-card {
  position: relative;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(24, 34, 29, 0.08);
}

.wall-card image {
  display: block;
  width: 100%;
  height: 244rpx;
  background: #dce4e8;
}

.live-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(216, 90, 58, 0.92);
  font-size: 20rpx;
  font-weight: 820;
}

.wall-info {
  padding: 16rpx;
}

.wall-info > text {
  display: block;
  height: 68rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #25465a;
  background: #dfe9ef;
  font-size: 21rpx;
}

.count {
  float: right;
  margin-top: 14rpx;
  color: #8a949b;
  font-size: 21rpx;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.card-tags text {
  max-width: 132rpx;
  height: 34rpx;
  padding: 0 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #66717b;
  background: #f0f3ee;
  font-size: 20rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
