<view class="page">
  <view class="hero">
    <text class="hero-kicker">WDBZK Gallery</text>
    <text class="hero-title">今日灵感墙</text>
    <text class="hero-subtitle">精选动静态壁纸，短链直达原始资源</text>
    <view class="hero-meter">
      <text>{{total}}</text>
      <text>已上架资源</text>
    </view>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索角色、风景、游戏、风格" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="reload" />
    <button class="search-button" bindtap="reload">搜索</button>
  </view>

  <view class="filter-row">
    <view class="filter {{sort === 'latest' ? 'active' : ''}}" data-sort="latest" bindtap="switchSort">最新</view>
    <view class="filter {{sort === 'hot' ? 'active' : ''}}" data-sort="hot" bindtap="switchSort">热门</view>
    <view wx:if="{{tag}}" class="tag-filter">#{{tag}}</view>
  </view>

  <view class="type-row">
    <view class="type-filter {{type === '' ? 'active' : ''}}" data-type="" bindtap="switchType">全部</view>
    <view class="type-filter {{type === 'live' ? 'active' : ''}}" data-type="live" bindtap="switchType">动态</view>
    <view class="type-filter {{type === 'static' ? 'active' : ''}}" data-type="static" bindtap="switchType">静态</view>
    <view class="type-filter {{type === 'mobile' ? 'active' : ''}}" data-type="mobile" bindtap="switchType">手机</view>
    <view class="type-filter {{type === 'desktop' ? 'active' : ''}}" data-type="desktop" bindtap="switchType">电脑</view>
  </view>

  <view class="section-title">
    <text>推荐资源</text>
    <text class="muted">{{total}} 张</text>
  </view>

  <view class="masonry">
    <block wx:for="{{items}}" wx:key="id">
      <view class="wall-card" bindtap="openDetail" data-id="{{item.id}}">
        <text wx:if="{{item.type === 'live'}}" class="live-ribbon">LIVE</text>
        <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <view class="wall-info">
          <text>{{item.title}}</text>
          <view>
            <text wx:if="{{item.type === 'live'}}" class="pill">动态</text>
            <text wx:elif="{{item.type === 'static'}}" class="pill">静态</text>
            <text wx:elif="{{item.type === 'mobile'}}" class="pill">手机</text>
            <text wx:elif="{{item.type === 'desktop'}}" class="pill">电脑</text>
            <text wx:else class="pill">其他</text>
            <text class="count">{{item.downloadCount}} 次下载</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && error}}" class="empty">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!loading && items.length === 0}}" class="empty">暂无壁纸</view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
</view>
