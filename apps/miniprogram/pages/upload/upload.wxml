<view class="page">
  <view class="up-grid">
    <block wx:for="{{files}}" wx:key="path">
      <view class="up-item">
        <image src="{{item.preview}}" mode="aspectFill" class="up-thumb" />
        <view class="up-remove" catchtap="removeFile" data-index="{{index}}">×</view>
        <view wx:if="{{item.type === 'video'}}" class="up-video-badge">视频</view>
      </view>
    </block>
    <view wx:if="{{files.length < 20}}" class="up-item up-add" bindtap="chooseMedia" hover-class="up-item-hover">
      <text class="up-plus">+</text>
      <text class="up-add-text">添加</text>
    </view>
  </view>
  <view class="up-option up-tags-header">
    <text>手动标签（可选）</text>
    <text class="up-tags-count" wx:if="{{manualTags.length}}">已添加 {{manualTags.length}} 个</text>
  </view>
  <view wx:if="{{manualTags.length}}" class="up-tag-list">
    <block wx:for="{{manualTags}}" wx:key="*this">
      <view class="up-tag">
        <text>{{item}}</text>
        <text class="up-tag-remove" catchtap="removeTag" data-tag="{{item}}">×</text>
      </view>
    </block>
  </view>
  <view class="up-tag-input-row">
    <input class="up-tag-input" placeholder="输入标签后回车，多个用逗号分隔" value="{{tagInput}}" bindinput="onTagInput" bindconfirm="addTag" confirm-type="done" />
    <view class="up-tag-add" bindtap="addTag">添加</view>
  </view>
  <view class="up-title-row">
    <input class="up-tag-input" placeholder="标题（可选，填写后跳过 AI 识别，直接同步网盘/发帖/上架）" value="{{titleInput}}" bindinput="onTitleInput" maxlength="40" />
  </view>
  <view class="up-option">
    <text>上传后自动发帖到频道</text>
    <switch checked="{{autoPublish}}" bindchange="onAutoPublishChange" color="#c05621" />
  </view>
  <text class="up-hint">默认关闭：只上传保存，不发帖；开启后会自动 AI 识别、上传网盘并发布到腾讯频道。</text>
  <button class="up-submit" bindtap="upload" disabled="{{!files.length || uploading}}" loading="{{uploading}}">
    上传{{files.length ? '（' + files.length + ' 张）' : ''}}
  </button>
</view>
