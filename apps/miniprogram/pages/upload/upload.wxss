.page {
  padding: 28rpx 32rpx;
}

.up-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.up-item {
  position: relative;
  width: 204rpx;
  height: 204rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2e7d9;
}

.up-thumb {
  width: 100%;
  height: 100%;
}

.up-item-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.up-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #a89484;
  font-size: 28rpx;
  box-sizing: border-box;
}

.up-plus {
  font-size: 64rpx;
  line-height: 1;
}

.up-add-text {
  font-size: 24rpx;
  color: #a89484;
}

.up-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  background: rgba(0, 0, 0, 0.55);
  border-bottom-left-radius: 16rpx;
}

.up-video-badge {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.55);
}

.up-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #2b211b;
  font-size: 28rpx;
}

.up-tags-header {
  margin-top: 26rpx;
}

.up-tags-count {
  color: #a89484;
  font-size: 22rpx;
}

.up-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.up-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #c05621;
  font-size: 24rpx;
  background: #fdeee6;
}

.up-tag-remove {
  padding: 0 2rpx;
  color: #c87d5f;
  font-size: 28rpx;
  line-height: 1;
}

.up-tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.up-tag-input {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #2b211b;
  font-size: 26rpx;
}

.up-tag-add {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 26rpx;
  background: linear-gradient(135deg, #e57355, #c05621);
}

.up-tag-add:active {
  opacity: 0.85;
}

.up-title-row {
  margin-top: 18rpx;
}

.up-hint {
  display: block;
  margin-top: 16rpx;
  color: #a89484;
  font-size: 22rpx;
  line-height: 1.5;
}

.up-submit {
  margin-top: 28rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #e57355, #c05621);
  box-shadow: 0 10rpx 24rpx rgba(192, 86, 33, 0.28);
  font-size: 30rpx;
  font-weight: 780;
}

.up-submit::after {
  border: 0;
}

.up-submit[disabled] {
  background: #e6d3c2;
  color: rgba(255, 255, 255, 0.8);
  box-shadow: none;
}

.up-submit:not([disabled]):active {
  transform: scale(0.98);
}
