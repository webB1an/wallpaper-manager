.request-page { padding-bottom: 80rpx; }
.request-hero { padding: 34rpx 30rpx; border-radius: 24rpx; color: #fff; background: #2b211b; }
.request-title { display: block; font-size: 42rpx; font-weight: 850; }
.request-subtitle { display: block; margin-top: 12rpx; color: rgba(255,255,255,.72); font-size: 24rpx; line-height: 1.6; }
.request-quota { display: inline-block; margin-top: 20rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: #e8b87b; background: rgba(255,255,255,.1); font-size: 22rpx; }
.request-form, .request-state, .request-history { margin-top: 24rpx; padding: 28rpx; border-radius: 18rpx; background: #fff; }
.request-state { color: #8a7668; text-align: center; }
.form-title, .history-heading { display: block; margin-bottom: 20rpx; color: #2b211b; font-size: 30rpx; font-weight: 800; }
.request-input, .request-textarea { display: block; box-sizing: border-box; width: 100%; margin-top: 16rpx; padding: 0 20rpx; border: 1rpx solid #ead8c4; border-radius: 12rpx; background: #fbf7f0; font-size: 25rpx; }
.request-input { height: 76rpx; line-height: 76rpx; }
.request-textarea { height: 210rpx; padding: 18rpx 20rpx; line-height: 1.55; }
.reference-section { margin-top: 20rpx; }
.reference-heading { display: flex; justify-content: space-between; color: #6f5d50; font-size: 23rpx; }
.reference-heading text:last-child { color: #a89484; }
.reference-grid, .history-reference-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.reference-item, .reference-add, .history-reference-grid image { position: relative; width: 142rpx; height: 142rpx; overflow: hidden; border-radius: 12rpx; }
.reference-item image { width: 100%; height: 100%; }
.reference-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #dfc7ab; color: #a89484; background: #fbf7f0; font-size: 21rpx; }
.reference-add text:first-child { margin-bottom: 4rpx; color: #c05621; font-size: 40rpx; line-height: 1; }
.reference-remove { position: absolute; top: 6rpx; right: 6rpx; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; color: #fff; background: rgba(43,33,27,.72); font-size: 28rpx; line-height: 1; }
.reference-hint { display: block; margin-top: 10rpx; color: #a89484; font-size: 20rpx; }
.picker-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.picker-row picker { flex: 1; padding: 20rpx; border-radius: 12rpx; color: #6f5d50; background: #f7ead8; font-size: 24rpx; text-align: center; }
.request-rule { display: block; margin-top: 18rpx; color: #a89484; font-size: 21rpx; line-height: 1.6; }
.submit-request { box-sizing: border-box; width: 100%; max-width: 100%; height: 76rpx; margin: 24rpx 0 0; padding: 0; border-radius: 12rpx; color: #fff; background: #c05621; font-size: 27rpx; font-weight: 760; line-height: 76rpx; }
.submit-request::after { border: 0; }
.request-card { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #efe4d6; border-radius: 14rpx; }
.request-card-head { display: flex; justify-content: space-between; gap: 16rpx; color: #2b211b; font-size: 26rpx; font-weight: 760; }
.request-card-head text:last-child { flex-shrink: 0; color: #c05621; }
.request-description, .admin-note, .request-date { display: block; margin-top: 12rpx; color: #8a7668; font-size: 22rpx; line-height: 1.55; }
.history-reference-grid image { width: 128rpx; height: 128rpx; }
.admin-note { color: #c05621; }
.request-date { color: #a89484; font-size: 20rpx; }
.request-card image { width: 180rpx; height: 110rpx; margin-top: 14rpx; border-radius: 10rpx; }
