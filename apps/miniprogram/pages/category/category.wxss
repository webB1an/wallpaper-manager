.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-card {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 150rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 2rpx solid #dbe4e8;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 32, 0.06);
}

.type-mark {
  position: absolute;
  top: 0;
  left: 0;
  width: 12rpx;
  height: 100%;
  background: #dd6b45;
}

.type-card-live .type-mark {
  background: #dd6b45;
}

.type-card-static .type-mark {
  background: #245167;
}

.type-card-mobile .type-mark {
  background: #e0a922;
}

.type-card-desktop .type-mark {
  background: #111820;
}

.type-card view text:first-child {
  display: block;
  color: #111820;
  font-size: 31rpx;
  font-weight: 820;
}

.type-card view text:last-child {
  display: block;
  margin-top: 12rpx;
  color: #6e7881;
  font-size: 23rpx;
}

.type-card-live {
  border-color: rgba(216, 90, 58, 0.42);
}

.type-card-live view text:first-child {
  color: #d85a3a;
}

.type-card-static {
  border-color: rgba(37, 70, 90, 0.38);
}

.type-card-static view text:first-child {
  color: #25465a;
}

.type-card-mobile {
  border-color: rgba(232, 181, 67, 0.56);
}

.type-card-mobile view text:first-child {
  color: #b37a12;
}

.type-count {
  align-self: flex-end;
  flex-shrink: 0;
  color: #111820;
  font-size: 24rpx;
  font-weight: 780;
}

.type-card-desktop {
  border-color: rgba(17, 24, 32, 0.32);
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
  min-height: 172rpx;
  padding: 22rpx;
  overflow: hidden;
  border-radius: 10rpx;
  color: #fff;
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #25465a, #d85a3a);
  font-size: 32rpx;
  font-weight: 800;
}

.category-card::before {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  content: "";
}

.category-index {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 760;
}

.category-name {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  font-weight: 620;
}

.category-card:nth-child(3n + 2) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.74)),
    linear-gradient(135deg, #5b6c7a, #e8b543);
}

.category-card:nth-child(3n) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #111820, #25465a);
}
