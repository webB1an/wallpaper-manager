.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-card {
  position: relative;
  display: block;
  gap: 18rpx;
  min-height: 188rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e4ddcc;
  border-radius: 22rpx;
  background: #fffdf7;
  box-shadow: 0 12rpx 30rpx rgba(42, 42, 34, 0.06);
}

.type-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  color: #fffdf7;
  background: #7a4f2b;
  font-size: 25rpx;
  font-weight: 840;
}

.type-card view {
  margin-top: 18rpx;
  min-width: 0;
}

.type-card view text:first-child {
  display: block;
  overflow: hidden;
  color: #2a2a22;
  font-size: 32rpx;
  font-weight: 840;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-card view text:last-child {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: #77766e;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-count {
  display: block;
  max-width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  color: #3f5c40;
  font-size: 24rpx;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.category-card {
  position: relative;
  min-height: 230rpx;
  overflow: hidden;
  border: 1rpx solid #e4ddcc;
  border-radius: 22rpx;
  color: #fffdf7;
  background: #2a2a22;
  box-shadow: 0 12rpx 30rpx rgba(42, 42, 34, 0.08);
}

.category-card image {
  display: block;
  width: 100%;
  height: 230rpx;
  background: #e8e2d2;
  filter: saturate(0.9) contrast(0.96);
}

.category-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(42, 42, 34, 0.06), rgba(42, 42, 34, 0.78));
}

.category-info {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
}

.category-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #2a2a22;
  background: #e6c55f;
  font-size: 20rpx;
  font-weight: 800;
}

.category-name {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: #fffdf7;
  font-size: 31rpx;
  font-weight: 860;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 253, 247, 0.78);
  font-size: 22rpx;
  font-weight: 620;
}

.category-skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-skeleton-card {
  height: 230rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0)),
    #e8e2d2;
  background-size: 240rpx 100%, 100% 100%;
  animation: tagSkeletonSweep 1.4s ease-in-out infinite;
}

@keyframes tagSkeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
