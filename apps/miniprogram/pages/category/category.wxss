.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-card {
  position: relative;
  display: block;
  gap: 18rpx;
  min-height: 188rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #efe4d6;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 28, 0.06);
}

.type-mark {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #c05621;
}

.type-card view {
  margin-top: 18rpx;
  min-width: 0;
}

.type-card view text:first-child {
  display: block;
  overflow: hidden;
  color: #2b211b;
  font-size: 32rpx;
  font-weight: 840;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-card view text:last-child {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: #8a7668;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-count {
  display: block;
  max-width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  color: #c05621;
  font-size: 24rpx;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.category-card {
  position: relative;
  min-height: 230rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 22rpx;
  color: #ffffff;
  background: #2b211b;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 28, 0.12);
}

.category-card image {
  display: block;
  width: 100%;
  height: 230rpx;
  background: #f0e4d6;
  filter: saturate(0.94) contrast(1);
}

.category-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(31, 35, 28, 0.08), rgba(31, 35, 28, 0.8));
}

.category-info {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
}

.category-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #e8b87b;
  font-size: 20rpx;
  font-weight: 800;
}

.category-name {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 860;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  font-weight: 620;
}

.category-skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-skeleton-card {
  height: 230rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: tagSkeletonSweep 1.4s ease-in-out infinite;
}

@keyframes tagSkeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}
