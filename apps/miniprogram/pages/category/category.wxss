.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-card {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 150rpx;
  padding: 22rpx;
  border: 2rpx solid #dbe4e8;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 32, 0.06);
}

.type-card view text:first-child {
  display: block;
  color: #111820;
  font-size: 31rpx;
  font-weight: 820;
}

.type-card view text:last-child {
  display: block;
  margin-top: 12rpx;
  color: #6e7881;
  font-size: 23rpx;
}

.type-card:nth-child(1) {
  border-color: rgba(216, 90, 58, 0.42);
}

.type-card:nth-child(1) view text:first-child {
  color: #d85a3a;
}

.type-card:nth-child(2) {
  border-color: rgba(37, 70, 90, 0.38);
}

.type-card:nth-child(2) view text:first-child {
  color: #25465a;
}

.type-card:nth-child(3) {
  border-color: rgba(232, 181, 67, 0.56);
}

.type-card:nth-child(3) view text:first-child {
  color: #b37a12;
}

.type-count {
  align-self: flex-end;
  flex-shrink: 0;
  color: #111820;
  font-size: 24rpx;
  font-weight: 780;
}

.type-card:nth-child(4) {
  border-color: rgba(17, 24, 32, 0.32);
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
  min-height: 172rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  color: #fff;
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #25465a, #d85a3a);
  font-size: 32rpx;
  font-weight: 800;
}

.category-card text:first-child {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-card text:last-child {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  font-weight: 620;
}

.category-card:nth-child(3n + 2) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.74)),
    linear-gradient(135deg, #5b6c7a, #e8b543);
}

.category-card:nth-child(3n) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #111820, #25465a);
}
