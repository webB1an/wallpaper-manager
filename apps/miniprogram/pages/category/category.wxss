.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-card {
  display: flex;
  align-items: flex-end;
  min-height: 172rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  color: #fff;
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #25465a, #d85a3a);
  font-size: 32rpx;
  font-weight: 800;
}

.category-card:nth-child(3n + 2) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.74)),
    linear-gradient(135deg, #5b6c7a, #e8b543);
}

.category-card:nth-child(3n) {
  background:
    linear-gradient(145deg, rgba(17, 24, 32, 0.08), rgba(17, 24, 32, 0.78)),
    linear-gradient(135deg, #111820, #25465a);
}
