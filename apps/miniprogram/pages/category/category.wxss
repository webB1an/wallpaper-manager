.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-card {
  position: relative;
  display: block;
  gap: 18rpx;
  min-height: 188rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #efe4d6;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 35, 28, 0.06);
}

.type-mark {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #c05621;
}

.type-card view {
  margin-top: 18rpx;
  min-width: 0;
}

.type-card view text:first-child {
  display: block;
  overflow: hidden;
  color: #2b211b;
  font-size: 32rpx;
  font-weight: 840;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-card view text:last-child {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: #8a7668;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-count {
  display: block;
  max-width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  color: #c05621;
  font-size: 24rpx;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.masonry-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 20rpx;
}

.masonry-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.poster-card {
  overflow: hidden;
  width: 100%;
  border: 1rpx solid #efe4d6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(43, 33, 27, 0.07);
}

.poster-card image {
  display: block;
  width: 100%;
  height: auto;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: cardShimmer 1.4s ease-in-out infinite;
}

.poster-info {
  padding: 16rpx;
}

.poster-title {
  display: block;
  overflow: hidden;
  color: #2b211b;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-count {
  display: block;
  margin-top: 10rpx;
  color: #c05621;
  font-size: 23rpx;
  font-weight: 700;
}

.category-skeleton-grid {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 26rpx;
}

.category-skeleton-grid .masonry-column {
  flex: 1;
}

.category-skeleton-card {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0)),
    #f0e4d6;
  background-size: 240rpx 100%, 100% 100%;
  animation: tagSkeletonSweep 1.4s ease-in-out infinite;
}

@keyframes tagSkeletonSweep {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}

@keyframes cardShimmer {
  0% {
    background-position: -260rpx 0, 0 0;
  }
  100% {
    background-position: 420rpx 0, 0 0;
  }
}

.back-top {
  position: fixed;
  z-index: 99;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #c05621;
  box-shadow: 0 10rpx 30rpx rgba(43, 33, 27, 0.22);
  font-size: 24rpx;
  font-weight: 700;
}
