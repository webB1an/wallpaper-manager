<view class="page">
  <view class="hero">
    <text class="hero-title">按标签探索</text>
    <text class="hero-subtitle">每个标签取一张热门封面，点进去看完整列表</text>
  </view>

  <view class="section-title">
    <text>资源类型</text>
    <text class="muted">静态 / 动态</text>
  </view>
  <view class="type-grid">
    <block wx:for="{{types}}" wx:key="key">
      <view class="type-card type-card-{{item.key}}" bindtap="openType" data-type="{{item.key}}">
        <text class="type-mark">{{item.icon}}</text>
        <view>
          <text>{{item.title}}</text>
          <text>{{item.subtitle}}</text>
        </view>
        <text class="type-count">{{item.count ? item.count + ' 张' : '暂无'}}</text>
      </view>
    </block>
  </view>

  <view class="section-title">
    <text>标签</text>
    <text class="muted">{{tags.length}} 个</text>
  </view>
  <view class="category-grid">
    <block wx:for="{{tags}}" wx:key="name">
      <view class="category-card" bindtap="openTag" data-tag="{{item.name}}">
        <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <view class="category-mask"></view>
        <view class="category-info">
          <text class="category-index">#{{index + 1}}</text>
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{item.count}} 张</text>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{loading && tags.length === 0}}" class="category-skeleton-grid">
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
  </view>
  <view wx:elif="{{!loading && error}}" class="empty state-card">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!loading && tags.length === 0}}" class="empty state-card">
    <text>暂无标签</text>
    <text class="empty-subtitle">上传并完成识别后会自动生成标签</text>
  </view>
</view>
