<view class="page">
  <view class="section-title">
    <text>资源类型</text>
    <text class="muted">静态 / 动态</text>
  </view>
  <view class="type-grid">
    <block wx:for="{{types}}" wx:key="key">
      <view class="type-card type-card-{{item.key}}" bindtap="openType" data-type="{{item.key}}">
        <image class="type-mark" src="/assets/icons/{{item.icon}}.png" />
        <view>
          <text>{{item.title}}</text>
          <text>{{item.subtitle}}</text>
        </view>
        <text class="type-count">{{item.count ? item.count + ' 张' : '暂无'}}</text>
      </view>
    </block>
  </view>

  <view class="section-title">
    <text>标签</text>
    <text class="muted">{{tags.length}} 个</text>
  </view>
  <view class="masonry-grid">
    <view class="masonry-column">
      <block wx:for="{{leftTags}}" wx:key="name">
        <view class="poster-card" bindtap="openTag" data-tag="{{item.name}}">
          <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
          <view class="poster-info">
            <text class="poster-title">#{{item.name}}</text>
            <text class="poster-count">{{item.count}} 张</text>
          </view>
        </view>
      </block>
    </view>
    <view class="masonry-column">
      <block wx:for="{{rightTags}}" wx:key="name">
        <view class="poster-card" bindtap="openTag" data-tag="{{item.name}}">
          <image src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
          <view class="poster-info">
            <text class="poster-title">#{{item.name}}</text>
            <text class="poster-count">{{item.count}} 张</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  <view wx:if="{{loading && tags.length === 0}}" class="category-skeleton-grid">
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
    <view class="category-skeleton-card"></view>
  </view>
  <view wx:elif="{{!loading && error}}" class="empty state-card">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!loading && tags.length === 0}}" class="empty state-card">
    <text>暂无标签</text>
    <text class="empty-subtitle">上传并完成识别后会自动生成标签</text>
  </view>
  <view wx:if="{{backTopVisible}}" class="back-top" bindtap="backTop"><image class="back-top-icon" src="/assets/icons/top.png" /></view>
</view>
