page {
  min-height: 100vh;
  background: #f4f6f1;
  color: #111820;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 52rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 30rpx;
  border-radius: 18rpx;
  color: #fff;
  background:
    linear-gradient(90deg, rgba(255, 209, 102, 0.14), transparent 42%),
    linear-gradient(135deg, #111820 0%, #18384c 52%, #d85a3a 145%);
  box-shadow: 0 18rpx 44rpx rgba(17, 24, 32, 0.16);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 18rpx;
  font-size: 32rpx;
  font-weight: 760;
}

.muted {
  color: #6e7881;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: #25465a;
  background: #dfe9ef;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 0;
  color: #7d887f;
  text-align: center;
}

.empty text {
  display: block;
}

.retry-button {
  width: 160rpx;
  height: 64rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #25465a;
  font-size: 24rpx;
  line-height: 64rpx;
}
