page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #f3f2ec;
  color: #20241f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
image,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  min-width: 0;
  margin: 0;
}

.page {
  min-height: 100vh;
  width: 100%;
  padding: 24rpx 24rpx 60rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  color: #fff;
  background:
    linear-gradient(90deg, rgba(227, 195, 94, 0.16), transparent 46%),
    linear-gradient(135deg, #20241f 0%, #3e5142 68%, #9b6a42 145%);
  box-shadow: 0 18rpx 42rpx rgba(32, 36, 31, 0.14);
}

.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.22;
  background-image:
    linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0 2rpx, transparent 2rpx 24rpx),
    linear-gradient(45deg, rgba(255, 255, 255, 0.1) 0 1rpx, transparent 1rpx 28rpx);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.16;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 16rpx;
  font-size: 32rpx;
  font-weight: 760;
}

.muted {
  color: #747b73;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: #2f4b3f;
  background: #e6ebe2;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 0;
  color: #7d887f;
  text-align: center;
}

.empty text {
  display: block;
}

.state-card {
  margin-top: 26rpx;
  padding: 56rpx 24rpx;
  border: 2rpx dashed #d9ded4;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
}

.empty-subtitle {
  margin-top: 10rpx;
  color: #98a39b;
  font-size: 23rpx;
}

.loading-more {
  padding: 30rpx 0 8rpx;
  color: #7d887f;
  font-size: 24rpx;
  text-align: center;
}

.retry-button {
  width: 160rpx;
  max-width: 100%;
  height: 64rpx;
  margin: 22rpx auto 0;
  padding: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #2f4b3f;
  font-size: 24rpx;
  line-height: 64rpx;
}
