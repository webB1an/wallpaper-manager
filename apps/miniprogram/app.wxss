page {
  min-height: 100vh;
  background: #f5f4ee;
  color: #111820;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 60rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx;
  border-radius: 18rpx;
  color: #fff;
  background:
    linear-gradient(90deg, rgba(255, 214, 121, 0.18), transparent 42%),
    linear-gradient(135deg, #101820 0%, #245167 56%, #dd6b45 145%);
  box-shadow: 0 18rpx 44rpx rgba(17, 24, 32, 0.15);
}

.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.22;
  background-image:
    linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0 2rpx, transparent 2rpx 24rpx),
    linear-gradient(45deg, rgba(255, 255, 255, 0.1) 0 1rpx, transparent 1rpx 28rpx);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.16;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 18rpx;
  font-size: 32rpx;
  font-weight: 760;
}

.muted {
  color: #6e7881;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: #245167;
  background: #deeaeb;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 0;
  color: #7d887f;
  text-align: center;
}

.empty text {
  display: block;
}

.state-card {
  margin-top: 26rpx;
  padding: 56rpx 24rpx;
  border: 2rpx dashed #dce4e8;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty-subtitle {
  margin-top: 10rpx;
  color: #98a39b;
  font-size: 23rpx;
}

.loading-more {
  padding: 30rpx 0 8rpx;
  color: #7d887f;
  font-size: 24rpx;
  text-align: center;
}

.retry-button {
  width: 160rpx;
  height: 64rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #25465a;
  font-size: 24rpx;
  line-height: 64rpx;
}
