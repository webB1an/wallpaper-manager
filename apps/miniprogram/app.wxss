page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #fbf7f0;
  color: #2b211b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
image,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  min-width: 0;
  margin: 0;
}

.page {
  min-height: 100vh;
  width: 100%;
  padding: 24rpx 24rpx calc(68rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 12%, rgba(230, 181, 102, 0.22), transparent 34%),
    linear-gradient(135deg, #c05621 0%, #8a5a34 100%);
  box-shadow: 0 18rpx 42rpx rgba(49, 74, 59, 0.22);
}

.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.22;
  background-image:
    linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0 2rpx, transparent 2rpx 24rpx),
    linear-gradient(45deg, rgba(255, 255, 255, 0.1) 0 1rpx, transparent 1rpx 28rpx);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 860;
  letter-spacing: 0;
  line-height: 1.16;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 16rpx;
  color: #2b211b;
  font-size: 32rpx;
  font-weight: 840;
}

.muted {
  color: #8a7668;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: #c05621;
  background: #f7ead8;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 0;
  color: #8a7668;
  text-align: center;
}

.empty text {
  display: block;
}

.state-card {
  margin-top: 26rpx;
  padding: 56rpx 24rpx;
  border: 2rpx dashed #efe4d6;
  border-radius: 20rpx;
  background: #ffffff;
}

.empty-subtitle {
  margin-top: 10rpx;
  color: #a89484;
  font-size: 23rpx;
}

.loading-more {
  padding: 30rpx 0 8rpx;
  color: #8a7668;
  font-size: 24rpx;
  text-align: center;
}

.retry-button {
  width: 160rpx;
  max-width: 100%;
  height: 64rpx;
  margin: 22rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #c05621;
  font-size: 24rpx;
  line-height: 64rpx;
}
