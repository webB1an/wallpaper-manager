page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #f8f5ea;
  color: #2a2a22;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
image,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  min-width: 0;
  margin: 0;
}

.page {
  min-height: 100vh;
  width: 100%;
  padding: 24rpx 24rpx 68rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border: 1rpx solid #e4ddcc;
  border-radius: 26rpx;
  color: #fffdf7;
  background:
    linear-gradient(90deg, rgba(230, 197, 95, 0.18), transparent 46%),
    linear-gradient(135deg, #2a2a22 0%, #3f5c40 68%, #7a4f2b 145%);
  box-shadow: 0 18rpx 42rpx rgba(42, 42, 34, 0.12);
}

.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.22;
  background-image:
    linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0 2rpx, transparent 2rpx 24rpx),
    linear-gradient(45deg, rgba(255, 255, 255, 0.1) 0 1rpx, transparent 1rpx 28rpx);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 860;
  letter-spacing: 0;
  line-height: 1.16;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 16rpx;
  color: #2a2a22;
  font-size: 32rpx;
  font-weight: 840;
}

.muted {
  color: #8a8174;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: #3f5c40;
  background: #e7eddf;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 0;
  color: #77766e;
  text-align: center;
}

.empty text {
  display: block;
}

.state-card {
  margin-top: 26rpx;
  padding: 56rpx 24rpx;
  border: 2rpx dashed #e1dac8;
  border-radius: 20rpx;
  background: rgba(255, 253, 247, 0.78);
}

.empty-subtitle {
  margin-top: 10rpx;
  color: #9a9487;
  font-size: 23rpx;
}

.loading-more {
  padding: 30rpx 0 8rpx;
  color: #77766e;
  font-size: 24rpx;
  text-align: center;
}

.retry-button {
  width: 160rpx;
  max-width: 100%;
  height: 64rpx;
  margin: 22rpx auto 0;
  padding: 0;
  border-radius: 12rpx;
  color: #fffdf7;
  background: #3f5c40;
  font-size: 24rpx;
  line-height: 64rpx;
}
