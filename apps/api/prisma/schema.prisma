generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WallpaperType {
  static
  live
  mobile
  desktop
  other
}

enum WallpaperStatus {
  draft
  processing
  pending_review
  published
  rejected
  archived
}

enum WallpaperOrientation {
  portrait
  landscape
  square
  unknown
}

enum RewardDownloadType {
  daily10
  unlimited
}

enum StorageProvider {
  quark
  baidu
}

enum TaskStatus {
  queued
  running
  success
  failed
  skipped
}

enum TaskType {
  upload_asset
  ai_classify
  quark_sync
  baidu_sync
  wdbzk_sync
  channel_publish
  old_cover_import
  asset_fetch
  auto_publish
}

model Wallpaper {
  id              String          @id @default(cuid())
  title           String
  originalName    String
  type            WallpaperType   @default(other)
  status          WallpaperStatus @default(draft)
  coverPath       String?
  coverUrl        String?
  assetPath       String?
  mimeType        String?
  fileSize        BigInt?
  tags            WallpaperTag[]
  storageLinks    StorageLink[]
  shortLinks      ShortLink[]
  clicks          WallpaperClick[]
  downloadTokens  DownloadToken[]
  favorites       UserFavorite[]
  downloads       UserDownload[]
  wallpaperSources WallpaperSource[]
  aiAnalysis      AiAnalysis?
  matchKey        String?         @db.VarChar(512)
  matchConfidence Float?
  sortOrder       Int             @default(0)
  orientation     WallpaperOrientation @default(unknown)
  viewCount       Int             @default(0)
  downloadCount   Int             @default(0)
  autoPublish     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, sortOrder])
  @@index([matchKey])
}

model WallpaperClick {
  id          String   @id @default(cuid())
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt, wallpaperId])
}

model WallpaperReward {
  id        String             @id @default(cuid())
  userId    String
  date      DateTime
  type      RewardDownloadType
  usedCount Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, date])
}

model DownloadToken {
  token       String   @id
  wallpaperId String
  userId      String
  filePath    String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model UserFavorite {
  id          String   @id @default(cuid())
  userId      String
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, wallpaperId])
  @@index([userId, createdAt])
}

model UserDownload {
  id          String   @id @default(cuid())
  userId      String
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, wallpaperId])
  @@index([userId, createdAt])
}

model Tag {
  id         String         @id @default(cuid())
  name       String         @unique
  createdAt  DateTime       @default(now())
  wallpapers WallpaperTag[]
}

model WallpaperTag {
  wallpaperId String
  tagId       String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([wallpaperId, tagId])
}

model StorageLink {
  id             String          @id @default(cuid())
  wallpaperId    String
  storageAccountId String?
  provider       StorageProvider
  url            String          @db.Text
  passcode       String?
  remotePath     String?
  remoteFileId   String?
  wdbzkResourceId Int?
  isPrimary      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wallpaper      Wallpaper       @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  storageAccount StorageAccount? @relation(fields: [storageAccountId], references: [id], onDelete: SetNull)
  shortLinks     ShortLink[]

  @@index([provider, isActive])
  @@index([wallpaperId])
  @@index([storageAccountId])
}

model StorageAccount {
  id             String          @id @default(cuid())
  provider       StorageProvider
  label          String
  profileDir     String          @db.VarChar(512)
  configPath     String?         @db.VarChar(512)
  accountName    String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  lastProbeOk    Boolean?
  lastProbeMessage String?       @db.Text
  lastProbeAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  storageLinks   StorageLink[]

  @@index([provider, isDefault])
  @@index([provider, isActive])
}

model ShortLink {
  id            String       @id @default(cuid())
  code          String       @unique
  wallpaperId   String
  storageLinkId String
  provider      StorageProvider
  clickCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  wallpaper     Wallpaper    @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  storageLink   StorageLink  @relation(fields: [storageLinkId], references: [id], onDelete: Cascade)
}

model AiAnalysis {
  id             String    @id @default(cuid())
  wallpaperId    String    @unique
  title          String
  type           WallpaperType
  tags           Json
  sensitiveFlags Json
  safe           Boolean
  summary        String?   @db.Text
  raw            Json?
  createdAt      DateTime  @default(now())
  wallpaper      Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(cuid())
  type        TaskType
  status      TaskStatus @default(queued)
  progress    Int        @default(0)
  message     String?    @db.Text
  payload     Json?
  result      Json?
  error       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ChannelAccount {
  id          String   @id @default(cuid())
  label       String
  tokenCipher String   @db.Text
  tokenTail   String
  guildId     String
  guildName   String?
  channelId   String
  channelName String?
  isDefault   Boolean  @default(false)
  autoPublish Boolean  @default(true)
  lastAutoPublishAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WallpaperSource {
  id          String   @id @default(cuid())
  source      String   @db.VarChar(64)
  sourceId    String   @db.VarChar(255)
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([source, sourceId])
  @@index([source, createdAt])
}

model AutoPublishBoard {
  id           String   @id @default(cuid())
  guildId      String   @db.VarChar(128)
  guildName    String?  @db.VarChar(160)
  channelId    String   @db.VarChar(128)
  channelName  String?  @db.VarChar(160)
  source       String   @db.VarChar(64) @default("wallpost")
  sourceConfig Json?
  enabled      Boolean  @default(false)
  intervalHours Int     @default(4)
  lastRunAt    DateTime?
  lastMessage  String?  @db.VarChar(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OldCoverImport {
  id              String   @id @default(cuid())
  coverFileName   String   @unique
  coverPath       String?
  candidateTitle  String
  matchKey        String   @db.VarChar(512)
  oldResourceId   Int?
  oldResourceName String?
  oldResourceLink String?  @db.Text
  confidence      Float    @default(0)
  status          String   @default("pending")
  message         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
